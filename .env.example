# ローカル開発用の設定例。.env にコピーして使う（.env はコミットしない）
DB_HOST=localhost
DB_PORT=5432
DB_NAME=komorebi
DB_USER=komorebi
DB_PASSWORD=change-me
API_PORT=8787

# エージェントのMCPサーバー（.codex/config.toml、.mcp.json の komorebi_db）が使う、読み取り専用の接続（開発用DBだけ）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=komorebi
POSTGRES_USER=komorebi_readonly
POSTGRES_PASSWORD=readonly-change-me
