{
  "type": "object",
  "additionalProperties": false,
  "required": ["change", "items", "assumptions", "open_questions"],
  "properties": {
    "change": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["area", "target", "location", "current",
                     "impact", "verdict", "evidence", "effort_days"],
        "properties": {
          "area": {
            "type": "string",
            "enum": ["画面", "API", "テーブル", "バッチ", "倉庫CSV",
                     "領収書", "メール", "テスト", "ドキュメント"]
          },
          "target": { "type": "string" },
          "location": { "type": "string" },
          "current": { "type": "string" },
          "impact": { "type": "string" },
          "verdict": { "type": "string",
                       "enum": ["要修正", "要確認", "影響なし"] },
          "evidence": { "type": "string" },
          "effort_days": { "type": ["number", "null"] }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } }
  }
}
