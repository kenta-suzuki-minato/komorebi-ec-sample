{
  "name": "komorebi-ec-sample",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "こもれびストア（架空のECサイト）の学習用サンプル",
  "license": "MIT",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.typecheck.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate": "node --env-file-if-exists=.env --import tsx packages/db/src/cli.ts migrate",
    "db:seed": "node --env-file-if-exists=.env --import tsx packages/db/src/cli.ts seed",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/server.ts",
    "dev:web": "pnpm --filter @komorebi/web dev",
    "build:web": "pnpm --filter @komorebi/web build",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "csv-parse": "7.0.3",
    "eslint": "9.39.5",
    "exceljs": "4.4.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "3.2.7"
  }
}
